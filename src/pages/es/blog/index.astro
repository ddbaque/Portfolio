---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { ui } from '../../../i18n/ui';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={ui.es.blog.title} description={ui.es.blog.description} locale="es" showRss />
	</head>
	<body>
		<Header />
		<main>
			<section class="blog-placeholder" aria-labelledby="blog-title">
				<h1 id="blog-title">El blog aún no está<br />aquí<span class="cursor" aria-hidden="true"></span></h1>
				<p class="lede">
					Estoy escribiendo sobre lo que me encuentro construyendo: backends en producción, colas,
					idempotencia, Postgres y las decisiones que solo te encuentras cuando toca escalar. Vuelve pronto.
				</p>

				<div class="terminal" aria-label="Estado del blog">
					<div class="terminal-titlebar" aria-hidden="true">
						<span class="terminal-dots"><i></i><i></i><i></i></span>
						<span>fish — ddbaque.dev</span>
					</div>
					<div class="terminal-body">
						<div><span class="prompt">$</span> ls ~/posts</div>
						<div class="output">ls: ~/posts: No existe el archivo o el directorio</div>
						<div class="command"><span class="prompt">$</span> git log --oneline -1</div>
						<div class="output">4d28ab6 blog: primer borrador en marcha</div>
					</div>
				</div>

				<nav class="actions" aria-label="Enlaces del blog">
					<a href="/">← volver al inicio</a>
					<a class="primary" href="https://github.com/ddbaque" target="_blank" rel="noopener noreferrer">
						mientras tanto, github
					</a>
				</nav>
			</section>
		</main>
		<Footer statusPath="~/blog" detail="3 borradores en marcha" />
	</body>
</html>

<style>
	:global(body) {
		display: flex;
		min-height: 100vh;
		flex-direction: column;
	}

	main {
		display: flex;
		flex: 1;
		align-items: flex-start;
		width: var(--w-site);
		max-width: 100%;
		padding-inline: var(--pad-x);
		padding-block: 118px 72px;
	}

	.blog-placeholder {
		width: min(620px, 100%);
	}

	h1 {
		margin: 0;
		font-size: var(--text-display);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-display);
		line-height: 1.08;
	}

	h1 .cursor {
		width: 0.5em;
		height: 0.92em;
		margin-left: 0.12em;
	}

	.lede {
		max-width: 61ch;
		margin: var(--s-26) 0 0;
		color: var(--fg-soft);
		font-size: var(--text-dek);
		line-height: 1.75;
	}

	.terminal {
		margin-top: var(--s-32);
		border: 1px solid var(--line-strong);
		background: var(--bg-elev);
		font-family: var(--font-mono);
		font-size: var(--text-code);
		line-height: var(--leading-code);
	}

	.terminal-titlebar {
		display: flex;
		align-items: center;
		gap: var(--s-14);
		min-height: 30px;
		padding-inline: var(--s-14);
		border-bottom: 1px solid var(--line);
		color: var(--fg-faint);
		font-size: var(--text-label);
		letter-spacing: var(--tracking-meta);
	}

	.terminal-dots {
		display: flex;
		gap: var(--s-6);
	}

	.terminal-dots i {
		width: 8px;
		height: 8px;
		background: var(--fg-ghost);
		border-radius: 50%;
	}

	.terminal-body {
		padding: var(--s-16);
		color: var(--fg);
	}

	.prompt {
		color: var(--accent);
	}

	.output {
		color: var(--fg-dim);
	}

	.command {
		margin-top: var(--s-22);
	}

	.actions {
		display: flex;
		gap: var(--s-12);
		margin-top: var(--s-32);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-meta);
	}

	.actions a {
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		padding-inline: var(--s-16);
		border: 1px solid var(--line-strong);
		color: var(--fg-prose);
	}

	.actions a:hover,
	.actions a:focus-visible {
		border-color: var(--fg-faint);
		color: var(--fg);
	}

	.actions .primary {
		border-color: var(--accent);
		color: var(--accent);
	}

	.actions .primary:hover,
	.actions .primary:focus-visible {
		background: var(--accent);
		color: var(--bg);
	}

	:global(footer) {
		margin-top: 0;
	}

	@media (max-width: 720px) {
		main {
			padding-inline: var(--s-16);
			padding-block: var(--s-72) var(--s-48);
		}

		h1 {
			font-size: 34px;
		}

		.lede {
			font-size: var(--text-body);
		}

		.actions {
			align-items: stretch;
			flex-direction: column;
		}

		.actions a {
			justify-content: center;
		}
	}
</style>
