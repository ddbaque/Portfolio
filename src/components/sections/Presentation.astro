---
import Button from '../buttons/Button.astro'
import MailIcon from '../Icons/MailIcon.astro'
import LinkedInIcon from '../Icons/LinkedInIcon.astro'
import Badge from '../Badge.astro'
import type { Lang } from '../../i18n/translations'
import { t } from '../../i18n/utils'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
---

<section class="w-full max-w-[960px] flex flex-col sm:flex-row items-center gap-10 sm:gap-16 px-5 pt-12 sm:pt-20 pb-8">
  <Badge>
    <div class="hidden sm:block w-[400px] h-[340px]">
      <img
        class="w-full h-full object-cover rounded-xl"
        src="/Portfolio/assets/desk.png"
        alt="presentation image"
      />
    </div>
  </Badge>
  <div class="flex flex-col justify-center items-start gap-6 max-w-[480px] animate-fade-up">
    <div class="flex flex-col gap-4">
      <div>
        <p class="text-custom-lightGray text-sm font-medium tracking-wide uppercase mb-2">{t(lang, 'hero.role')}</p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gradient leading-tight">
          David Baque
        </h1>
      </div>
      <p class="text-sm sm:text-base text-custom-lightGray leading-relaxed">
        {t(lang, 'hero.description')}
        {' '}<span class="text-custom-teal font-medium">Go</span> y
        <span class="text-custom-teal font-medium">TypeScript</span>,
        {t(lang, 'hero.description.end')}
      </p>
    </div>
    <div class="flex gap-3">
      <Button
        btnName={t(lang, 'hero.contact')}
        Icon={MailIcon}
        url="mailto:baquedavid0@gmail.com"
      />
      <Button
        btnName="LinkedIn"
        Icon={LinkedInIcon}
        url="https://www.linkedin.com/in/ddbaque/"
      />
    </div>
  </div>
</section>
