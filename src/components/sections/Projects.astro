---
import ProjectCard from '../PorjectCard.astro'
import CodeIcon from '../Icons/CodeIcon.astro'
import HeaderSection from '../HeaderSection.astro'
import type { Lang } from '../../i18n/translations'
import { t } from '../../i18n/utils'

interface Props {
  lang: Lang
}
const { lang } = Astro.props

const projects = [
  {
    title: 'TakeOrder',
    description: t(lang, 'project.takeorder.description'),
    imageUrl: '/assets/take-order-mockup.png',
    technologies: ['js', 'ts', 'react', 'postgres', 'raspberry-pi', 'express-js', 'aws'],
    codeUrl: 'https://github.com/Neby-Services',
    deployUrl: '#',
  },
  {
    title: 'Neby',
    description: t(lang, 'project.neby.description'),
    imageUrl: '/assets/neby-mockup.png',
    technologies: ['next-js', 'ts', 'postgres', 'docker', 'cpp', 'aws'],
    codeUrl: 'https://github.com/Neby-Services',
    deployUrl: '#',
  },
  {
    title: 'Portfolio',
    description: t(lang, 'project.portfolio.description'),
    imageUrl: '/assets/portfolio-mockup.png',
    technologies: ['ts', 'figma', 'astro'],
    codeUrl: 'https://github.com/ddbaque/Portfolio',
    deployUrl: 'https://ddbaque.dev',
    designUrl: 'https://www.figma.com/community/file/1469359695744263835',
  },
]
---

<section class="w-full max-w-[960px] flex flex-col gap-8 px-5" id="projects">
  <HeaderSection Icon={CodeIcon} title={t(lang, 'section.projects')} />
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
    {projects.map((project) => <ProjectCard data={project} lang={lang} />)}
  </div>
</section>
