---
import SkillIcon from '../Icons/SkillIcon.astro'
import SkillCard from '../SkillCard.astro'
import HeaderSection from '../HeaderSection.astro'
import type { Lang } from '../../i18n/translations'
import { t } from '../../i18n/utils'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
---

<section class="w-full max-w-[960px] flex flex-col gap-8 px-5" id="skills">
  <HeaderSection title={t(lang, 'section.skills')} Icon={SkillIcon} />

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
    <SkillCard icon="ui" title={t(lang, 'skill.ui')} description={t(lang, 'skill.ui.desc')} />
    <SkillCard icon="frontend" title={t(lang, 'skill.frontend')} description={t(lang, 'skill.frontend.desc')} />
    <SkillCard icon="backend" title={t(lang, 'skill.backend')} description={t(lang, 'skill.backend.desc')} />
    <SkillCard icon="database" title={t(lang, 'skill.database')} description={t(lang, 'skill.database.desc')} />
    <SkillCard icon="cloud" title={t(lang, 'skill.cloud')} description={t(lang, 'skill.cloud.desc')} />
    <SkillCard icon="other" title={t(lang, 'skill.other')} description={t(lang, 'skill.other.desc')} />
  </div>
</section>
