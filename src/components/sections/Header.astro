---
import CircularLogoIcon from '../Icons/CircularLogoIcon.astro'
import NameLogoIcon from '../Icons/NameLogoIcon.astro'
import HeaderOption from '../HeaderOption.astro'
import LanguageSwitcher from '../LanguageSwitcher.astro'
import type { Lang } from '../../i18n/translations'
import { t } from '../../i18n/utils'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
---

<header
  class="w-full max-w-[960px] mx-auto flex justify-between items-center px-5 py-3 sm:px-6 sm:py-4 rounded-2xl mt-3"
>
  <div class="hidden sm:flex items-center gap-3">
    <CircularLogoIcon />
    <NameLogoIcon />
  </div>
  <div class="flex items-center gap-4 w-full sm:w-auto justify-between sm:justify-end">
    <nav class="flex gap-1 w-full sm:w-auto justify-between sm:justify-end">
      <HeaderOption ref="projects" title={t(lang, 'nav.projects')} />
      <HeaderOption ref="experience" title={t(lang, 'nav.experience')} />
      <HeaderOption ref="skills" title={t(lang, 'nav.skills')} />
    </nav>
    <div class="hidden sm:block">
      <LanguageSwitcher lang={lang} />
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 8px;
    z-index: 1000;
    transition: all 0.4s ease;
  }
  header.scrolled {
    background: rgba(8, 9, 11, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
</style>

<script>
  document.addEventListener('scroll', () => {
    const header = document.querySelector('header')
    if (window.scrollY > 30) header?.classList.add('scrolled')
    else header?.classList.remove('scrolled')
  })
</script>
