---
import { localeDefinitions, type Locale } from '../i18n/config';

interface Props {
	date: Date;
	locale?: Locale;
}

const { date, locale = 'es' } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(localeDefinitions[locale].dateLocale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
