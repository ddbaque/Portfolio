---
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { localeDefinitions, type Locale } from '../i18n/config';
import '../styles/global.css';

interface AlternateLink {
	locale: Locale;
	href: string;
}

interface Props {
	title: string;
	description: string;
	locale: Locale;
	image?: ImageMetadata;
	alternates?: AlternateLink[];
	xDefaultHref?: string;
	showRss?: boolean;
}

const {
	title,
	description,
	locale,
	image = FallbackImage,
	alternates = [],
	xDefaultHref,
	showRss = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image.src, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
<link rel="sitemap" href="/sitemap-index.xml" />
{
	showRss && (
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Blog | David Baque"
			href={new URL('/es/blog/rss.xml', Astro.site)}
		/>
	)
}
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />
{
	alternates.map((alternate) => (
		<link
			rel="alternate"
			hreflang={localeDefinitions[alternate.locale].htmlLang}
			href={new URL(alternate.href, Astro.site)}
		/>
	))
}
{xDefaultHref && <link rel="alternate" hreflang="x-default" href={new URL(xDefaultHref, Astro.site)} />}

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={localeDefinitions[locale].openGraphLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />

<meta name="twitter:card" content="summary_large_image" />
