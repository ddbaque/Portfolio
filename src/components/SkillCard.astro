---
import BoxIcon from './Icons/BoxIcon.astro'
import CloudIcon from './Icons/CloudIcon.astro'
import DbIcon from './Icons/DbIcon.astro'
import DrawIcon from './Icons/DrawIcon.astro'
import BackIcon from './Icons/BackIcon.astro'
import ComputerIcon from './Icons/ComputerIcon.astro'

type SkillIconType =
  | 'ui'
  | 'database'
  | 'backend'
  | 'frontend'
  | 'cloud'
  | 'other'

interface Props {
  title: string
  description: string
  icon: SkillIconType
}
const { title, description, icon } = Astro.props

const iconMap = {
  ui: DrawIcon,
  frontend: ComputerIcon,
  backend: BackIcon,
  database: DbIcon,
  cloud: CloudIcon,
  other: BoxIcon,
}

const IconComponent = iconMap[icon]
---

<article
  class="rounded-xl bg-glass-1 border border-subtle p-5 flex flex-col gap-3 hover:bg-glass-2 hover:border-medium transition-all duration-300"
>
  {IconComponent && <IconComponent class="w-6 h-6 text-custom-pink" />}
  <div class="flex flex-col gap-1">
    <h3 class="text-sm font-semibold text-white">{title}</h3>
    <p class="text-xs text-custom-lightGray">{description}</p>
  </div>
</article>
