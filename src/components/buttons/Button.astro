---
interface Props {
  btnName: string
  Icon?: any
  url: string
}
const { btnName, Icon, url } = Astro.props
---

<a
  href={url}
  target={url.startsWith('mailto') ? '_self' : '_blank'}
  rel="noopener noreferrer"
  class="group inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium rounded-full
    bg-glass-2 border border-subtle text-custom-lightGray
    hover:bg-glass-3 hover:border-medium hover:text-white
    transition-all duration-300"
>
  {Icon && <Icon class="w-4 h-4" />}
  <span>{btnName}</span>
</a>
