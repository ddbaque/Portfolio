---
const pathname = Astro.url.pathname;
const isBlog = pathname.startsWith('/blog');
const isPortfolio = !isBlog;
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href="/" aria-label="Ir al portfolio">
			<span aria-hidden="true">~/</span>ddbaque
		</a>

		<nav class="desktop-navigation" aria-label="Navegación principal">
			<a href="/#experiencia">experiencia</a>
			<a href="/#proyectos">proyectos</a>
			<a href="/#habilidades">habilidades</a>
			<a href="/blog" class:list={{ active: isBlog }} aria-current={isBlog ? 'page' : undefined}>blog</a>
		</nav>

		<div class="languages" aria-label="Idioma actual: español">
			<span class="active" lang="es">ES</span>
			<span class="separator" aria-hidden="true">·</span>
			<span lang="en">EN</span>
			<span class="separator" aria-hidden="true">·</span>
			<span lang="ca">CA</span>
		</div>

		<nav class="mobile-navigation" aria-label="Navegación principal">
			<a href="/" class:list={{ active: isPortfolio }} aria-current={isPortfolio ? 'page' : undefined}>
				portfolio
			</a>
			<a href="/blog" class:list={{ active: isBlog }} aria-current={isBlog ? 'page' : undefined}>
				blog
			</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--bg);
	}

	.header-inner {
		display: flex;
		align-items: center;
		width: var(--w-site);
		max-width: 100%;
		height: var(--h-header);
		margin-inline: auto;
		padding-inline: var(--pad-x);
		border-bottom: 1px solid var(--line);
	}

	.brand,
	.desktop-navigation,
	.mobile-navigation,
	.languages {
		font-family: var(--font-mono);
		line-height: var(--leading-ui);
	}

	.brand {
		flex: none;
		color: var(--fg);
		font-size: 14px;
		font-weight: var(--weight-semibold);
		letter-spacing: -0.01em;
	}

	.brand span {
		color: var(--accent);
	}

	.desktop-navigation {
		display: flex;
		align-self: stretch;
		gap: var(--s-22);
		margin-left: 28px;
		font-size: var(--text-nav);
		font-weight: var(--weight-medium);
	}

	.desktop-navigation a,
	.mobile-navigation a {
		display: flex;
		align-items: center;
		color: var(--fg-muted);
	}

	.desktop-navigation a:hover,
	.desktop-navigation a:focus-visible,
	.mobile-navigation a:hover,
	.mobile-navigation a:focus-visible,
	.desktop-navigation a.active,
	.mobile-navigation a.active {
		color: var(--fg);
	}

	.languages {
		display: flex;
		align-items: center;
		gap: var(--s-14);
		margin-left: auto;
		color: var(--fg-faint);
		font-size: var(--text-meta);
		font-weight: var(--weight-medium);
		letter-spacing: var(--tracking-meta);
	}

	.languages .active {
		color: var(--fg);
	}

	.languages .separator {
		color: var(--rule);
	}

	.mobile-navigation {
		display: none;
		align-self: stretch;
		gap: var(--s-18);
		margin-left: auto;
		font-size: var(--text-nav);
		font-weight: var(--weight-medium);
	}

	@media (max-width: 600px) {
		.header-inner {
			height: 52px;
			padding-inline: var(--s-16);
		}

		.desktop-navigation,
		.languages {
			display: none;
		}

		.mobile-navigation {
			display: flex;
		}
	}
</style>
