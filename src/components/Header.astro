---
import { localeDefinitions, locales } from '../i18n/config';
import { getLocaleFromUrl, getPortfolioPath, getSpanishBlogPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const pathname = Astro.url.pathname;
const isBlog = pathname.startsWith('/es/blog');
const isPortfolio = !isBlog;

const localeLinks = locales.map((targetLocale) => ({
	locale: targetLocale,
	href: isBlog && targetLocale === 'es' ? pathname : getPortfolioPath(targetLocale),
	label: localeDefinitions[targetLocale].label,
}));
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href={getPortfolioPath(locale)} aria-label={t.a11y.goToPortfolio}>
			<span aria-hidden="true">~/</span>ddbaque
		</a>

		<nav class="desktop-navigation" aria-label={t.a11y.mainNavigation}>
			<a href={getPortfolioPath(locale, 'experiencia')}>{t.nav.experience}</a>
			<a href={getPortfolioPath(locale, 'proyectos')}>{t.nav.projects}</a>
			<a href={getPortfolioPath(locale, 'habilidades')}>{t.nav.skills}</a>
			<a
				href={getSpanishBlogPath()}
				class:list={{ active: isBlog }}
				aria-current={isBlog ? 'page' : undefined}
				hreflang="es"
				lang={locale === 'es' ? undefined : 'es'}
				title={locale === 'es' ? undefined : t.a11y.blogInSpanish}
			>
				{t.nav.blog}
			</a>
		</nav>

		<nav class="languages" aria-label={t.a11y.languageSelector}>
			{
				localeLinks.map((item, index) => (
					<>
						{index > 0 && (
							<span class="separator" aria-hidden="true">
								·
							</span>
						)}
						<a
							href={item.href}
							class:list={{ active: item.locale === locale }}
							aria-current={item.locale === locale ? 'page' : undefined}
							hreflang={item.locale}
							lang={item.locale}
							aria-label={`${t.a11y.changeLanguage} ${item.label}`}
						>
							{item.label}
						</a>
					</>
				))
			}
		</nav>

		<nav class="mobile-navigation" aria-label={t.a11y.mainNavigation}>
			<a
				href={getPortfolioPath(locale)}
				class:list={{ active: isPortfolio }}
				aria-current={isPortfolio ? 'page' : undefined}
			>
				{t.nav.portfolio}
			</a>
			<a
				href={getSpanishBlogPath()}
				class:list={{ active: isBlog }}
				aria-current={isBlog ? 'page' : undefined}
				hreflang="es"
				lang={locale === 'es' ? undefined : 'es'}
				title={locale === 'es' ? undefined : t.a11y.blogInSpanish}
			>
				{t.nav.blog}
			</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--bg);
	}

	.header-inner {
		display: flex;
		align-items: center;
		width: var(--w-site);
		max-width: 100%;
		height: var(--h-header);
		margin-inline: auto;
		padding-inline: var(--pad-x);
		border-bottom: 1px solid var(--line);
	}

	.brand,
	.desktop-navigation,
	.mobile-navigation,
	.languages {
		font-family: var(--font-mono);
		line-height: var(--leading-ui);
	}

	.brand {
		flex: none;
		color: var(--fg);
		font-size: 14px;
		font-weight: var(--weight-semibold);
		letter-spacing: -0.01em;
	}

	.brand span {
		color: var(--accent);
	}

	.desktop-navigation {
		display: flex;
		align-self: stretch;
		gap: var(--s-22);
		margin-left: 28px;
		font-size: var(--text-nav);
		font-weight: var(--weight-medium);
	}

	.desktop-navigation a,
	.mobile-navigation a {
		display: flex;
		align-items: center;
		color: var(--fg-muted);
	}

	.desktop-navigation a:hover,
	.desktop-navigation a:focus-visible,
	.mobile-navigation a:hover,
	.mobile-navigation a:focus-visible,
	.desktop-navigation a.active,
	.mobile-navigation a.active {
		color: var(--fg);
	}

	.languages {
		display: flex;
		align-items: center;
		gap: var(--s-14);
		margin-left: auto;
		font-size: var(--text-meta);
		font-weight: var(--weight-medium);
		letter-spacing: var(--tracking-meta);
	}

	.languages a {
		color: var(--fg-faint);
	}

	.languages a:hover,
	.languages a:focus-visible,
	.languages a.active {
		color: var(--fg);
	}

	.languages .separator {
		color: var(--rule);
	}

	.mobile-navigation {
		display: none;
		align-self: stretch;
		gap: var(--s-18);
		margin-left: auto;
		font-size: var(--text-nav);
		font-weight: var(--weight-medium);
	}

	@media (max-width: 600px) {
		.header-inner {
			height: 52px;
			padding-inline: var(--s-16);
		}

		.desktop-navigation {
			display: none;
		}

		.mobile-navigation {
			display: flex;
			gap: var(--s-14);
		}

		.languages {
			gap: var(--s-8);
			margin-left: var(--s-14);
			font-size: var(--text-label);
		}

		.languages .separator {
			display: none;
		}
	}
</style>
