---
import type { SkillGroup } from '../types/portfolio';

interface Props {
	items: SkillGroup[];
}

const { items } = Astro.props;
const debian = `       _,met$$$$$gg.
    ,g$$$$$$$$$$$$$$$P.
  ,g$$P"     """Y$$.".
 ,$$P'              \`$$$.
',$$P       ,ggs.     \`$$b:
\`d$$'     ,$P"'   .    $$$
 $$P      d$'     ,    $$P
 $$:      $$.   -    ,d$$'
 $$;      Y$b._   _,d$P'
 Y$$.    \`.\`"Y$$$$P"'
 \`$$b      "-.__
  \`Y$$
   \`Y$$.
     \`$$b.
       \`Y$$b.
          \`"Y$b._
              \`"""`;
---

<div class="terminal">
	<div class="terminal-bar" aria-hidden="true">
		<span></span><span></span><span></span>
	</div>
	<div class="terminal-content">
		<div class="ascii" aria-hidden="true">
			<pre>{debian}</pre>
		</div>
		<div class="profile">
			<p class="user">ddbaque@ddbaque</p>
			<div class="rule" aria-hidden="true">───────────────</div>
			<dl>
				{
					items.map((group) => (
						<div>
							<dt>{group.label}</dt>
							<dd>{group.items.join(' · ')}</dd>
						</div>
					))
				}
			</dl>
			<div class="palette" aria-hidden="true">
				<span></span><span></span><span></span><span></span><span></span><span></span>
			</div>
		</div>
	</div>
</div>

<style>
	.terminal {
		border: 1px solid var(--line);
		background: var(--bg-code);
	}

	.terminal-bar {
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 9px var(--s-12);
		border-bottom: 1px solid var(--line);
		background: var(--bg-elev);
	}

	.terminal-bar span {
		width: var(--s-8);
		height: var(--s-8);
		border-radius: 50%;
		background: var(--rule);
	}

	.terminal-content {
		display: grid;
		grid-template-columns: 250px minmax(0, 1fr);
	}

	.ascii {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--s-22) var(--s-18);
		border-right: 1px solid var(--line);
	}

	pre {
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--accent-deep);
		font-family: var(--font-mono);
		font-size: 9px;
		line-height: 1.15;
		white-space: pre;
	}

	.profile {
		min-width: 0;
		padding: var(--s-18) var(--s-26);
		font-family: var(--font-mono);
		font-size: 12.5px;
		line-height: 1.5;
	}

	.user {
		margin: 0;
		color: var(--fg);
	}

	.rule {
		margin-top: -6px;
		color: var(--rule);
	}

	dl {
		display: grid;
		gap: 9px;
		margin: var(--s-8) 0 0;
	}

	dl div {
		display: grid;
		grid-template-columns: 130px minmax(0, 1fr);
		gap: var(--s-16);
	}

	dt {
		color: var(--accent);
	}

	dd {
		min-width: 0;
		margin: 0;
		color: var(--fg-prose);
	}

	.palette {
		display: flex;
		gap: var(--s-6);
		margin-top: var(--s-14);
	}

	.palette span {
		width: 13px;
		height: 13px;
	}

	.palette span:nth-child(1) { background: var(--select); }
	.palette span:nth-child(2) { background: var(--accent-deep); }
	.palette span:nth-child(3) { background: var(--accent); }
	.palette span:nth-child(4) { background: var(--syn-string); }
	.palette span:nth-child(5) { background: var(--fg-prose); }
	.palette span:nth-child(6) { background: var(--fg); }

	@media (max-width: 700px) {
		.terminal-content {
			grid-template-columns: minmax(0, 1fr);
		}

		.ascii {
			border-right: 0;
			border-bottom: 1px solid var(--line);
		}

		.profile {
			padding: var(--s-18);
		}
	}

	@media (max-width: 420px) {
		dl div {
			grid-template-columns: minmax(0, 1fr);
			gap: 2px;
		}
	}
</style>
