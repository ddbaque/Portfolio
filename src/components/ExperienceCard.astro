---
interface Props {
  position: string
  time: string
  description: string
  company: string
}
const { description, position, time, company } = Astro.props
---

<div class="relative pl-8 pb-8 last:pb-0">
  <!-- Timeline line -->
  <div class="absolute left-[7px] top-3 bottom-0 w-px bg-gradient-to-b from-custom-pink/40 to-custom-blue/20"></div>

  <!-- Timeline dot -->
  <div class="absolute left-0 top-2.5 w-[15px] h-[15px] rounded-full border-2 border-custom-pink bg-custom-black"></div>

  <!-- Card -->
  <div class="rounded-xl bg-glass-1 border border-subtle p-5 hover:bg-glass-2 hover:border-medium transition-all duration-300">
    <div class="flex flex-col gap-1.5">
      <span class="text-xs font-medium text-custom-muted uppercase tracking-wide">{time}</span>
      <h3 class="text-base font-semibold text-white">{company}</h3>
      <p class="text-sm font-medium text-custom-pink">{position}</p>
      <p class="text-sm text-custom-lightGray leading-relaxed mt-1">
        {description}
      </p>
    </div>
  </div>
</div>
