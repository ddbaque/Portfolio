---
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import { localeDefinitions, locales, type Locale } from '../i18n/config';
import { getPortfolioPath, useTranslations } from '../i18n/utils';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const alternates = locales.map((alternateLocale) => ({
	locale: alternateLocale,
	href: getPortfolioPath(alternateLocale),
}));
---

<!doctype html>
<html lang={localeDefinitions[locale].htmlLang}>
	<head>
		<BaseHead
			title={t.meta.title}
			description={t.meta.description}
			{locale}
			{alternates}
			xDefaultHref={getPortfolioPath('es')}
		/>
	</head>
	<body>
		<Header />
		<main>
			<Hero {locale} />
		</main>
	</body>
</html>

<style>
	main {
		width: var(--w-site);
		max-width: 100%;
		padding: 0 var(--pad-x);
	}

	@media (max-width: 600px) {
		main {
			padding-inline: var(--s-16);
		}
	}
</style>
