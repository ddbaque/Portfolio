---
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const statusPath = Astro.url.pathname.includes('/blog/')
	? '~/blog/index.astro'
	: '~/portfolio/index.astro';
---

<footer>
	<div class="footer-inner">
		<div class="status" aria-label={t.footer.statusLabel}>
			<span class="status-value">NORMAL</span>
			<span class="status-path" aria-hidden="true">{statusPath}</span>
		</div>
		<nav aria-label={t.footer.navigationLabel}>
			<a href="https://github.com/ddbaque" target="_blank" rel="noopener noreferrer">github</a>
			<a href="https://www.linkedin.com/in/ddbaque/" target="_blank" rel="noopener noreferrer">
				linkedin
			</a>
			<a href="mailto:baquedavid0@gmail.com">{t.footer.email}</a>
		</nav>
	</div>
</footer>

<style>
	footer {
		width: var(--w-site);
		max-width: 100%;
		margin: var(--s-56) auto 0;
		padding-inline: var(--pad-x);
	}

	.footer-inner {
		display: flex;
		align-items: center;
		min-height: 34px;
		border-top: 1px solid var(--line);
		background: var(--bg-elev);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: var(--tracking-meta);
		line-height: var(--leading-ui);
	}

	.status,
	nav {
		display: flex;
		align-items: center;
	}

	.status {
		min-width: 0;
	}

	.status-value,
	.status-path,
	nav a {
		display: inline-flex;
		align-items: center;
		min-height: 34px;
		padding-inline: var(--s-12);
	}

	.status-value {
		color: var(--accent);
		font-weight: var(--weight-semibold);
	}

	.status-path {
		overflow: hidden;
		color: var(--fg-caption);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	nav {
		margin-left: auto;
	}

	nav a {
		color: var(--fg-faint);
	}

	nav a:hover,
	nav a:focus-visible {
		color: var(--accent);
	}

	@media (max-width: 600px) {
		footer {
			padding-inline: var(--s-16);
		}

		.status-path {
			display: none;
		}

		.status-value,
		nav a {
			padding-inline: var(--s-8);
		}
	}
</style>
